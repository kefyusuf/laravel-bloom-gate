{
    "name": "local/bloom-gate-swoole-experiment",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "13.34.0",
        "laravel/octane": "2.20.0",
        "fakerphp/faker": "^1.24",
        "kefyusuf/laravel-bloom-gate": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "pestphp/pest": "^4.0",
        "openswoole/ide-helper": "^26.0"
    },
    "repositories": [{
        "type": "path",
        "url": "/package",
        "options": {"symlink": false, "versions": {"kefyusuf/laravel-bloom-gate": "dev-main"}}
    }],
    "config": {"allow-plugins": {"pestphp/pest-plugin": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
