    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "kefyusuf/laravel-bloom-gate": "dev-main"
    },
    "repositories": [
        {
            "type": "path",
